{
  "name": "n64core",
  "version": "0.1.0",
  "description": "Nintendo 64 emulator core compiled to WebAssembly, with a WebGPU renderer",
  "keywords": [
    "emulator",
    "n64",
    "nintendo64",
    "tas",
    "wasm",
    "webgpu"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./n64core.wasm": "./crate/target/wasm32-unknown-unknown/release/n64core.wasm"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./n64core.wasm": "./dist/n64core.wasm"
    }
  },
  "scripts": {
    "build:wasm": "cd crate && cargo build --release --target wasm32-unknown-unknown",
    "build": "pnpm build:wasm && vp pack",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74"
  }
}
